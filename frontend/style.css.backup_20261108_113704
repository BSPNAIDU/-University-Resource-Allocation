/* ==========================================
   SMART UNIVERSITY PORTAL - PREMIUM THEME
   ========================================== */

:root {
    --navy: #102448;
    --navy-light: #193761;
    --blue: #2864dc;
    --blue-light: #eaf2ff;
    --cyan: #21a6c7;
    --background: #f3f6fc;
    --surface: #ffffff;
    --text: #172b4d;
    --muted: #718096;
    --border: #e5ebf4;
    --green: #15966a;
}

/* Main application */

.stApp {
    background:
        radial-gradient(circle at 90% 5%, #e5efff 0%, transparent 27%),
        linear-gradient(135deg, #f7f9fd, #eef3fb) !important;
    color: var(--text) !important;
}

[data-testid="stAppViewContainer"] {
    background: transparent !important;
}

[data-testid="stHeader"] {
    background: rgba(255,255,255,0.85) !important;
    backdrop-filter: blur(12px);
}

[data-testid="stMain"] {
    background: transparent !important;
}

[data-testid="stMainBlockContainer"] {
    max-width: 1500px;
    padding: 2rem 2.5rem 4rem;
}

/* Sidebar */

[data-testid="stSidebar"] {
    background: linear-gradient(180deg, #102448 0%, #142f57 55%, #0b1b35 100%) !important;
    border-right: 1px solid #263f66;
}

[data-testid="stSidebar"] * {
    color: #edf4ff !important;
}

[data-testid="stSidebar"] h1,
[data-testid="stSidebar"] h2,
[data-testid="stSidebar"] h3 {
    color: #ffffff !important;
}

[data-testid="stSidebar"] [data-testid="stMarkdownContainer"] p {
    color: #d6e4ff !important;
}

/* Sidebar navigation animations */

[data-testid="stSidebar"] [data-testid="stPageLink"] {
    border-radius: 10px;
    margin: 5px 0;
    transition: all 0.25s ease;
}

[data-testid="stSidebar"] [data-testid="stPageLink"]:hover {
    background: rgba(255,255,255,0.13);
    transform: translateX(5px);
}

[data-testid="stSidebar"] [aria-current="page"] {
    background: linear-gradient(90deg, #2864dc, #4388f5) !important;
    border-radius: 10px;
}

/* Typography */

h1, h2, h3, h4 {
    color: #142b50 !important;
    font-weight: 750 !important;
    letter-spacing: -0.45px;
}

h1 {
    font-size: 2.35rem !important;
}

p, label {
    color: #40516d;
}

/* Entrance animations */

@keyframes fadeUp {
    from {
        opacity: 0;
        transform: translateY(18px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateX(-15px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

@keyframes softGlow {
    0%, 100% {
        box-shadow: 0 5px 18px rgba(40,100,220,0.08);
    }
    50% {
        box-shadow: 0 8px 25px rgba(40,100,220,0.17);
    }
}

[data-testid="stMainBlockContainer"] > div {
    animation: fadeUp 0.55s ease both;
}

[data-testid="stSidebar"] {
    animation: slideIn 0.45s ease both;
}

/* Welcome banner - main page title area */

.portal-banner {
    position: relative;
    overflow: hidden;
    padding: 30px 34px;
    border-radius: 20px;
    margin-bottom: 28px;
    background: linear-gradient(115deg, #102448, #1d4e91 65%, #2877cf);
    color: white;
    box-shadow: 0 12px 30px rgba(16,36,72,0.18);
    animation: fadeUp 0.65s ease both;
}

.portal-banner::after {
    content: "";
    position: absolute;
    width: 250px;
    height: 250px;
    right: -55px;
    top: -110px;
    border-radius: 50%;
    border: 35px solid rgba(255,255,255,0.08);
}

.portal-banner h1,
.portal-banner h2,
.portal-banner p {
    color: white !important;
    position: relative;
    z-index: 1;
}

.portal-banner p {
    opacity: 0.85;
}

/* KPI cards */

[data-testid="stMetric"] {
    position: relative;
    overflow: hidden;
    background: linear-gradient(145deg, #ffffff, #f9fbff) !important;
    border: 1px solid #e3eaf5 !important;
    border-radius: 17px !important;
    padding: 22px 20px !important;
    min-height: 125px;
    box-shadow: 0 5px 18px rgba(20,43,80,0.055);
    transition: transform 0.28s ease,
                box-shadow 0.28s ease,
                border-color 0.28s ease;
    animation: fadeUp 0.6s ease both;
}

[data-testid="stMetric"]:hover {
    transform: translateY(-6px);
    border-color: #9bbcf4 !important;
    box-shadow: 0 14px 30px rgba(40,100,220,0.13);
}

[data-testid="stMetricLabel"] {
    color: #667792 !important;
    font-size: 0.9rem !important;
    font-weight: 650 !important;
}

[data-testid="stMetricValue"] {
    color: #1e56ad !important;
    font-weight: 800 !important;
    font-size: 2.1rem !important;
}

/* Buttons */

.stButton > button {
    background: linear-gradient(110deg, #2864dc, #397ee9) !important;
    color: white !important;
    border: none !important;
    border-radius: 10px !important;
    padding: 0.62rem 1.25rem !important;
    font-weight: 650 !important;
    box-shadow: 0 4px 12px rgba(40,100,220,0.16);
    transition: all 0.25s ease !important;
}

.stButton > button:hover {
    transform: translateY(-3px);
    box-shadow: 0 9px 20px rgba(40,100,220,0.25);
    background: linear-gradient(110deg, #194fbf, #2864dc) !important;
}

.stButton > button:active {
    transform: scale(0.97);
}

/* Input fields */

[data-testid="stTextInput"] input,
[data-testid="stNumberInput"] input,
[data-testid="stDateInput"] input {
    background: white !important;
    color: #172b4d !important;
    border: 1px solid #dce5f1 !important;
    border-radius: 10px !important;
}

[data-testid="stSelectbox"] [data-baseweb="select"] {
    background: white !important;
    border-radius: 10px !important;
}

/* Tables */

[data-testid="stDataFrame"],
[data-testid="stTable"] {
    background: white !important;
    border: 1px solid #e1e8f2 !important;
    border-radius: 14px !important;
    overflow: hidden;
    box-shadow: 0 4px 14px rgba(20,43,80,0.045);
    animation: fadeIn 0.55s ease both;
}

/* Charts */

[data-testid="stPlotlyChart"] {
    background: white !important;
    border: 1px solid #e1e8f2 !important;
    border-radius: 16px !important;
    padding: 12px !important;
    box-shadow: 0 5px 18px rgba(20,43,80,0.055);
    transition: transform 0.25s ease,
                box-shadow 0.25s ease;
}

[data-testid="stPlotlyChart"]:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(20,43,80,0.09);
}

/* File uploader */

[data-testid="stFileUploader"] {
    background: white !important;
    border: 2px dashed #8bb1ed !important;
    border-radius: 16px !important;
    padding: 18px !important;
    transition: all 0.3s ease;
}

[data-testid="stFileUploader"]:hover {
    border-color: #2864dc !important;
    background: #f3f7ff !important;
}

/* Alerts */

[data-testid="stAlert"] {
    border-radius: 12px !important;
    animation: fadeIn 0.4s ease both;
}

/* Dividers and spacing */

hr {
    border-color: #dce5f1 !important;
    margin: 1.8rem 0 !important;
}

/* Hide Streamlit branding */

#MainMenu {
    visibility: hidden;
}

footer {
    visibility: hidden;
}

/* Accessibility: respect reduced-motion preferences */

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }
}
